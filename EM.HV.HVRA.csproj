  <PropertyGroup>
    <PostBuildEvent>@echo off
setlocal

:: Mendapatkan tanggal dan waktu saat ini
for /f "tokens=2 delims==" %25%25i in ('"wmic os get localdatetime /value"') do set datetime=%25%25i
set year=%25datetime:~0,4%25
set month=%25datetime:~4,2%25
set day=%25datetime:~6,2%25
set hour=%25datetime:~8,2%25
set minute=%25datetime:~10,2%25
set second=%25datetime:~12,2%25

:: Membuat nama file baru dengan format YYYY_MMDD_HHMMSS
set newfilename=$(TargetName)_%25year%25_%25month%25%25day%25_%25hour%25%25minute%25%25second%25.sap1
:: Mengganti nama file target
Rename "$(TargetDir)$(TargetName).dll" %25newfilename%25

endlocal</PostBuildEvent>
